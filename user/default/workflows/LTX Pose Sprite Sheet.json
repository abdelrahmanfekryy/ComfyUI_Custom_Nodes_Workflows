65]}],"properties":{"Node name for S&R":"ImageScaleBy"},"widgets_values":["area",1.0],"title":"Sprite scale (1.0 = video size)","color":"#232","bgcolor":"#353"},{"id":42,"type":"ImageConcatFromBatch","pos":[2730,720],"size":[250,130],"flags":{},"order":0,"mode":0,"inputs":[{"name":"images","type":"IMAGE","link":62},{"name":"num_columns","type":"INT","widget":{"name":"num_columns"},"link":63}],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[64]}],"properties":{"Node name for S&R":"ImageConcatFromBatch","cnr_id":"comfyui-kjnodes"},"widgets_values":[3,false,16384],"title":"Sprite sheet (one row)"},{"id":43,"type":"SaveImage","pos":[3000,600],"size":[420,300],"flags":{},"order":0,"mode":0,"inputs":[{"name":"images","type":"IMAGE","link":61}],"outputs":[],"properties":{"Node name for S&R":"SaveImage"},"widgets_values":["sprites/pose_frame"],"title":"Save frames (transparent PNG)","color":"#223","bgcolor":"#335"},{"id":44,"type":"SaveImage","pos":[3000,930],"size":[420,300],"flags":{},"order":0,"mode":0,"inputs":[{"name":"images","type":"IMAGE","link":64}],"outputs":[],"properties":{"Node name for S&R":"SaveImage"},"widgets_values":["sprites/pose_sheet"],"title":"Save sprite sheet (transparent PNG)","color":"#223","bgcolor":"#335"},{"id":45,"type":"VHS_VideoCombine","pos":[2430,1000],"size":[280,420],"flags":{},"order":0,"mode":0,"inputs":[{"name":"images","type":"IMAGE","link":65},{"name":"audio","type":"AUDIO","link":null},{"name":"meta_batch","type":"VHS_BatchManager","link":null},{"name":"vae","type":"VAE","link":null},{"name":"frame_rate","type":"FLOAT","widget":{"name":"frame_rate"},"link":66}],"outputs":[{"name":"Filenames","type":"VHS_FILENAMES","links":[]}],"properties":{"Node name for S&R":"VHS_VideoCombine","cnr_id":"comfyui-videohelpersuite"},"widgets_values":{"frame_rate":8,"loop_count":0,"filename_prefix":"sprites/pose_preview","format":"image/gif","pingpong":false,"save_output":true,"videopreview":{"hidden":false,"paused":false,"params":{}}},"title":"Loop preview (GIF)"},{"id":46,"type":"MarkdownNote","pos":[-440,0],"size":[420,900],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"Pose sprite workflow: how to use","properties":{},"color":"#432","bgcolor":"#653","widgets_values":["# LTX Pose Sprite Sheet\n\nLike *LTX Sprite Sheet Generator*, but the motion is **dictated by a pose video**\n(LTX-2.3 IC-LoRA Union Control) instead of being guessed from the prompt.\n\n**1. Character reference**: full-body image on a plain background.\n\n**2. Pose**: DWPose finds the character's own skeleton, then *Animate the skeleton*\nmoves it through a looping motion. Because it's the character's own skeleton, proportions\nand position match, and frame 0 is the reference pose.\n- `march in place`, `idle (breathing)`: work with any reference.\n- `walk/run in place (side view)`: need a **side-view** reference. They never pass through\n  the standing pose, so the clip opens with a `lead_in` (default 8 frames) that eases from the\n  reference into the walk; the full cycle(s) follow and the lead-in is left out of the sprite.\n- `cycles`: full motion cycles after the lead-in. `amplitude`: swing size.\n- The reference is pinned as the first frame, and also as the last frame only when the clip\n  ends on the reference pose (march, idle): `image_guides` sets this automatically.\nCheck *Pose video preview* and *Pose info* before generating.\n\n**3. Prompt**: describe the **same** motion as the skeleton.\n\n**4. Sprite frames**: frames to keep. They are spread over exactly one complete pose cycle\n(`loop_start`..`loop_end` from the pose node, the last cycle when there are several), so the\nsprite starts and ends where the skeleton's cycle does.\n\n**Outputs** (`output/sprites/`): `pose_raw_*.mp4`, `pose_frame_*.png`, `pose_sheet_*.png`,\n`pose_preview_*.gif`.\n\n**Models**: same LTX-2.3 distilled GGUF files as the v6 workflow, plus\n`loras/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors` (Lightricks, LTX-2 Community License).\nThe IC-LoRA nodes come from `ComfyUI-SpriteTools` (no ComfyUI-LTXVideo needed).\nVideo width/height must be multiples of 64 (the control video runs at half size).\n"]},{"id":47,"type":"PreviewAny","pos":[340,720],"size":[300,220],"flags":{},"order":0,"mode":0,"inputs":[{"name":"source","type":"*","link":70}],"outputs":[],"properties":{"Node name for S&R":"PreviewAny"},"widgets_values":[],"title":"Pose info"}],"links":[[1,1,0,2,0,"IMAGE"],[2,2,0,3,0,"INT"],[3,2,1,3,1,"INT"],[4,1,1,4,0,"MASK"],[5,3,0,5,0,"IMAGE"],[6,1,0,5,1,"IMAGE"],[7,4,0,5,2,"MASK"],[8,5,0,6,0,"IMAGE"],[9,6,0,7,0,"IMAGE"],[10,7,0,8,0,"IMAGE"],[11,6,0,9,0,"IMAGE"],[12,9,1,10,0,"POSE_KEYPOINT"],[13,10,0,11,0,"IMAGE"],[14,12,0,13,0,"MODEL"],[15,14,0,17,0,"CLIP"],[16,17,0,18,0,"CONDITIONING"],[17,17,0,19,0,"CONDITIONING"],[18,18,0,19,1,"CONDITIONING"],[19,6,0,20,0,"IMAGE"],[20,20,0,21,0,"INT"],[21,20,1,21,1,"INT"],[22,10,1,21,2,"INT"],[23,10,1,22,1,"INT"],[24,16,0,22,0,"VAE"],[25,19,0,23,0,"CONDITIONING"],[26,19,1,23,1,"CONDITIONING"],[27,15,0,23,2,"VAE"],[28,21,0,23,3,"LATENT"],[29,8,0,23,4,"IMAGE"],[30,23,0,24,0,"CONDITIONING"],[31,23,1,24,1,"CONDITIONING"],[32,15,0,24,2,"VAE"],[33,23,2,24,3,"LATENT"],[34,10,0,24,4,"IMAGE"],[35,13,1,24,5,"FLOAT"],[36,24,2,25,0,"LATENT"],[37,22,0,25,1,"LATENT"],[38,13,0,29,0,"MODEL"],[39,24,0,29,1,"CONDITIONING"],[40,24,1,29,2,"CONDITIONING"],[41,26,0,30,0,"NOISE"],[42,29,0,30,1,"GUIDER"],[43,27,0,30,2,"SAMPLER"],[44,28,0,30,3,"SIGMAS"],[45,25,0,30,4,"LATENT"],[46,30,0,31,0,"LATENT"],[47,24,0,32,0,"CONDITIONING"],[48,24,1,32,1,"CONDITIONING"],[49,31,0,32,2,"LATENT"],[50,10,1,32,3,"INT"],[51,32,2,33,0,"LATENT"],[52,15,0,33,1,"VAE"],[53,33,0,34,0,"IMAGE"],[54,34,0,35,0,"VIDEO"],[55,33,0,37,0,"IMAGE"],[56,36,0,37,1,"INT"],[57,37,3,38,0,"STRING"],[58,37,0,40,0,"IMAGE"],[59,39,0,40,1,"BIREFNET_MODEL"],[60,40,0,41,0,"IMAGE"],[61,41,0,43,0,"IMAGE"],[62,41,0,42,0,"IMAGE"],[63,36,0,42,1,"INT"],[64,42,0,44,0,"IMAGE"],[65,41,0,45,0,"IMAGE"],[66,37,2,45,4,"FLOAT"],[67,10,4,8,1,