# Ignore everything at root
*
!.gitignore
!AGENTS.md
!run.sh
!custom_nodes/
!user/

# Inside custom_nodes: ignore all subdirectories (un-ignore your custom ones with !)
/custom_nodes/*
!/custom_nodes/ComfyUI-LightOnOCR-GGUF/
!/custom_nodes/ComfyUI-LightOnOCR-GGUF/**
!/custom_nodes/ComfyUI-QwenImageEditMulti/
!/custom_nodes/ComfyUI-QwenImageEditMulti/**
!/custom_nodes/ComfyUI-SpriteTools/
!/custom_nodes/ComfyUI-SpriteTools/**

# Inside user: ignore everything except workflows
/user/*
!/user/default/
/user/default/*
!/user/default/workflows/
!/user/default/workflows/LightOnOCR_GGUF_Workflow.json
!/user/default/workflows/image_qwen_image_edit_2511.json
!/user/default/workflows/LTX Sprite Sheet Generator.json

# Python bytecode caches (must stay after the ! rules above to take effect)
__pycache__/
